# Compiled bytecode: platform- and version-specific, never worth committing.
__pycache__/
*.py[cod]

# Generated artifacts, not source. The cache and its receipt are produced by
# `prepare` and `validate` on a machine that has PySCF; `results/` is produced by
# `vqe` and `adapt`. All three are reproducible from the source in this folder,
# and the cache is large enough that committing it would dominate the repository.
#
# Commit them deliberately if you want a specific run archived -- `git add -f
# hamiltonian_cas6e6o.json hamiltonian_cas6e6o.validated.json` -- and keep the
# pair together, since the receipt is bound to the cache by hash and is
# meaningless without it.
hamiltonian_cas6e6o.json
hamiltonian_cas6e6o.validated.json
results/

# Local environments
.venv/
venv/
